# Application
APP_NAME="Pingsmith Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pingsmith
# DB_USERNAME=pingsmith
# DB_PASSWORD=

# Cache & Queue
CACHE_STORE=file
QUEUE_CONNECTION=database
# For production, use Redis:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Session & Broadcasting
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Vite
VITE_APP_NAME="${APP_NAME}"

# Status Page Settings
STATUS_PAGE_ENABLED=true
STATUS_PAGE_DEFAULT_THEME=dark

# Analytics Settings  
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_DEFAULT_PERIOD=7d

# Monitor Settings
MONITOR_DEFAULT_INTERVAL=60
MONITOR_DEFAULT_TIMEOUT=10
MONITOR_MAX_CONSECUTIVE_FAILURES=2

# Maintenance Mode
MAINTENANCE_MODE_ENABLED=true
MAINTENANCE_ALERT_SUPPRESSION=true
